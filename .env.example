# Required. Get one at https://eodhd.com/register?utm_source=eodhd_oss&utm_medium=app&utm_campaign=news-sentiment&utm_content=env
# Whether a key reaches news and sentiment depends on the plan; whatever yours
# lacks is named on screen in EODHD's own words. Mind the metering: sentiment
# costs 5 API units per symbol and each News tab 5 a load, against the free
# tier's 20 a day; on the free tier the app starts with one symbol, on a paid
# plan with three.
# It stays on this machine and is never sent to the browser.
EODHD_API_KEY=your_api_key_here

# Optional. Enables the AI analysis buttons. Without it every other part of the
# app works and the AI affordances simply do not appear.
# OPENAI_API_KEY=

# Optional. Any OpenAI-compatible endpoint works — Groq, DeepSeek, OpenRouter,
# or a local Ollama at http://localhost:11434/v1.
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Optional. The local port, if 5173 is taken (Vite's default is the same one).
# PORT=5173
